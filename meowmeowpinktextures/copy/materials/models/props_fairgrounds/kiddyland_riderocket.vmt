VertexLitGeneric
{

// this is to prevent the maps from applying a color tint to this texture
$allowdiffusemodulation 0

$baseTexture "models\props_fairgrounds/kiddyland_riderocket"
$blendtintbybasealpha 1
$envmap env_cubemap
$envmapmask "models\props_fairgrounds\kiddyland_riderocket_specmask"
$envmapsaturation ".4"
$EnvmapTint "[0.7 0.7 0.7]"
}
