vertexlitGeneric
{
$baseTexture "models/props_misc/fairground_tents"
$surfaceprop metal
$model 1
$envmap env_cubemap
$envmaptint "[ .5 .5 .5 ]"

// this is to prevent the maps from applying a different colored
// tint to the tents
$allowdiffusemodulation 0

$basealphaenvmapmask 1
$basealphaenvmapmaskMinMaxExp "[0 0.8 5]" 
$envmapfresnel 1
$envmapFresnelMinMaxExp "[.1 2 3]"
$blendtintbybasealpha 1
}
