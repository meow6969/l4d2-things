VertexLitGeneric
{
$baseTexture "models\props_vehicles/pickup_trucks"
$blendtintbybasealpha 1
$surfaceprop metal
$model 1

// this is to prevent the maps from applying a different colored
// tint to the cars
$allowdiffusemodulation 0

$envmap env_cubemap
$envmapfresnel 1
$envmapFresnelMinMaxExp "[.7 1 4]"
$envmapmask "Models/props_vehicles/pickup_trucks_ref"
}
