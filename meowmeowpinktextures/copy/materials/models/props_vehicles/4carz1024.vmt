VertexLitGeneric
{

$basetexture "Models/props_vehicles/4carz1024"

$surfaceprop metal
$model 1
$blendtintbybasealpha 1


// this is to prevent the maps from applying a different colored
// tint to the cars
$allowdiffusemodulation 0



$envmap env_cubemap

$envmapmask "Models/props_vehicles/4carz1024_envmask"


$envmapfresnel 1
$envmapFresnelMinMaxExp "[.1 2 3]"



}
