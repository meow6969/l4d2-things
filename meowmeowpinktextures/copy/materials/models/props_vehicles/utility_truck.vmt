VertexLitGeneric
{
$baseTexture "models\props_vehicles/utility_truck"
$envmap env_cubemap
$envmapmask "models\props_vehicles\utility_truck_ref"
$blendtintbybasealpha 1
$envmaptint "[.5 .5 .5]"

// this is to prevent the maps from applying a different colored
// tint to the cars
$allowdiffusemodulation 0

$envmapcontrast ".85"
$envmapsaturation ".2"
vertexlitgeneric_HDR_dx9
{
$envmaptint "[.5 .5 .5]"
$envmapcontrast ".5"
}
}

