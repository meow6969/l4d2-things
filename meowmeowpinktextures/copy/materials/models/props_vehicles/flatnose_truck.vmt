VertexLitGeneric
{

$basetexture "Models/props_vehicles/flatnose_truck"

$surfaceprop metal
$model 1
$blendtintbybasealpha 1

// this is to prevent the maps from applying a different colored
// tint to the cars
$allowdiffusemodulation 0

$envmap env_cubemap
$envmaptint "[ .5 .5 .5 ]"

$basealphaenvmapmask 1
$basealphaenvmapmaskMinMaxExp "[0 1 3]" 
$envmapfresnel 1
$envmapfresnelMinMaxExp "[0.1 3 3]"



}
