VertexLitGeneric
{
	$baseTexture "models\DoktorHaus\plasticknife"

	$ambientocclusion 1
	$halflambert 1

	$envmap "env_cubemap"
	$basealphaenvmapmask 1
	$envmaptint "[0.5 0.5 0.5]"
	
	$phong 1
	$allowdiffusemodulation 0
	$phongfresnelranges "[.01 .15 1]"
	$phongtint "[0.8 0.8 1]"
	$phongboost 30
	$phongexponent 20
}