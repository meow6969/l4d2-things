Water
{
$normalmap "liquids/water_river_normal_sharp"
$flowmap "liquids/c3m1_hflowmap"
$flow_normaluvscale 155.0
$flow_worlduvscale 0.5
$flow_timeintervalinseconds 0.2 
$flow_uvscrolldistance 0.075 
$flow_bumpstrength 0.4
$flow_timescale 0.5
$flow_noise_texture "liquids/water_noise"
$flow_noise_scale 0.0003
$flow_debug 0
$reflecttexture _rt_WaterReflection
$reflectamount "0.4"
$reflecttint "{ 0 64 128 }"
$reflectskyboxonly 1
$reflectentities 1
$refract 1
$refractamount "0.15"
$refracttint "{0 64 128}"
$abovewater 1
$bottommaterial "liquids/water_swamp_m1_beneath"
$fogenable 1
$fogstart 0
$fogend 6
$lightmapwaterfog 1

$fogcolor "[0 64 128]"
$flashlighttint 1
"%compilewater" 1
"%tooltexture" "nature/water_frame01_normal"
$surfaceprop slime
}
